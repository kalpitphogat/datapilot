# Copy to .env and fill in.
# Nebius Token Factory (required for the hackathon submission): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# NVIDIA API, free for development, no card needed: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Optional: enables web context. Get a key at https://tavily.com
TAVILY_API_KEY=
# Optional: default model ID (otherwise the first Nemotron model available is used)
DEFAULT_MODEL=
